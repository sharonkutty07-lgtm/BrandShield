# BrandShield Environment Configuration
# Optional: Configure real SMTP credentials (e.g. Gmail) for live email dispatch.
# If left empty, BrandShield runs in test mode and displays/logs OTPs to the terminal & UI.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=BrandShield Security
SMTP_FROM_EMAIL=your_email@gmail.com

BRANDSHIELD_SESSION_SECRET=brandshield-secure-session-key-2026
